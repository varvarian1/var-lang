func myFunc() as int {
    echo("Some text");
    return 0;
}

func main() as int {
    int x = 10 * 10;
    echo(x);

    

    if (x < 11) {
        echo("x < 11");
    } else {
        echo("11");
    }

    for (int i = 0; i < 11; i++) {
        echo(i);
    }

    myFunc();

    echo("end");

    return 0;
}
